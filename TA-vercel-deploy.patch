diff --git a/README.md b/README.md
index 5ecb8e4..c4bf602 100644
--- a/README.md
+++ b/README.md
@@ -260,3 +260,21 @@ ## Keterbatasan saat ini
 ## Menempelkan ke proyek Laravel yang sudah ada
 
 Kode ini ditulis untuk Laravel 13 dan Tailwind v4. Jika Anda sudah punya proyek Laravel 13 dengan skeleton standar, salin folder `app`, `database`, `lang`, `resources`, `routes`, `tests`, serta file `bootstrap/app.php`, `config/app.php`, `config/filesystems.php`, `vite.config.js`, `phpunit.xml`, dan `.env.example` (cocokkan isinya dengan milik Anda, jangan menimpa begitu saja jika sudah ada perubahan). Migrasi bersifat tambahan: tabel `users` ditambah kolom, bukan dibuat ulang. Setelah itu jalankan `php artisan migrate --seed`.
+
+## Deploy ke Vercel
+
+Konfigurasinya sudah ada di repo: `vercel.json` (runtime `vercel-php@0.8.0`, PHP 8.4), `api/index.php` (pintu masuk Laravel di Vercel), `.vercelignore`, dan skrip `vercel` di `composer.json` (membangun aset Vite ke dalam bundel fungsi).
+
+1. Di Vercel: Add New > Project, impor repo ini. Framework Preset dan Build Command dibiarkan, sudah diatur oleh `vercel.json`.
+2. Di Settings > Environment Variables isi `APP_KEY` (hasil `php artisan key:generate --show`) dan `APP_URL` (alamat situs di Vercel).
+3. Deploy.
+
+Tanpa pengaturan lain, aplikasi berjalan dalam **mode demo**: `database/database.sqlite` disalin ke `/tmp`, sesi memakai cookie, dan berkas unggahan disimpan di `/tmp`. Isi `/tmp` hilang saat instance fungsi berganti dan tidak dibagi antar-instance, jadi data baru (akun, pengajuan, dokumen) tidak permanen. Cukup untuk demo atau presentasi.
+
+Untuk data permanen, isi `DB_CONNECTION` (`mysql` atau `pgsql`) beserta `DB_URL` atau `DB_HOST`, `DB_PORT`, `DB_DATABASE`, `DB_USERNAME`, `DB_PASSWORD` di Vercel. Mode demo otomatis tidak dipakai, sesi dan cache memakai database. Muat dulu struktur dan data awal ke database itu (untuk MySQL: `database/sql/arsip_kp_ta.sql`, atau `php artisan migrate --seed` dari komputer Anda dengan `.env` yang menunjuk ke database tersebut).
+
+Batasan di Vercel:
+
+- Berkas unggahan masih di `/tmp` (disk `local`), jadi tidak permanen walaupun database sudah permanen. Penyimpanan permanen perlu disk S3 dan perubahan kode, karena aplikasi memanggil `Storage::disk('local')` secara langsung.
+- Batas ukuran request ke fungsi Vercel adalah 4,5 MB, lebih kecil dari batas dokumen 5 MB di Pengaturan Persyaratan.
+- Perubahan skema harus dipasang sendiri ke database yang dipakai; Vercel tidak menjalankan `migrate`. Pada mode demo, perbarui `database/database.sqlite` di repo.
diff --git a/api/index.php b/api/index.php
new file mode 100644
index 0000000..30063aa
--- /dev/null
+++ b/api/index.php
@@ -0,0 +1,95 @@
+<?php
+
+use Illuminate\Http\Request;
+
+/*
+| Pintu masuk Laravel di Vercel (runtime vercel-php). Dipakai bersama vercel.json; tidak dipakai saat
+| pengembangan lokal (lokal tetap lewat public/index.php dan php artisan serve).
+|
+| Filesystem fungsi Vercel read-only kecuali /tmp, sedangkan Laravel perlu menulis cache, view
+| terkompilasi, log, dan berkas unggahan. Semuanya diarahkan ke /tmp. Isi /tmp hanya hidup selama
+| instance fungsi berjalan dan tidak dibagi antar-instance.
+|
+| Nilai bawaan di bawah hanya dipakai bila belum diisi di Environment Variables Vercel (yang diisi
+| di sana selalu menang). Satu-satunya yang wajib diisi di Vercel: APP_KEY.
+|
+| Mode demo (DB_CONNECTION kosong atau sqlite): database/database.sqlite disalin ke /tmp, sesi
+| memakai cookie, cache memakai berkas. Perubahan data hilang saat instance berganti, jadi cukup untuk
+| demo atau presentasi. Untuk data permanen, isi DB_CONNECTION (mysql/pgsql) beserta kredensialnya
+| di Vercel; mode demo otomatis tidak dipakai dan sesi/cache memakai database.
+*/
+
+define('LARAVEL_START', microtime(true));
+
+$ambil = static function (string $kunci): ?string {
+    foreach ([$_SERVER[$kunci] ?? null, $_ENV[$kunci] ?? null, getenv($kunci)] as $nilai) {
+        if (is_string($nilai) && $nilai !== '') {
+            return $nilai;
+        }
+    }
+
+    return null;
+};
+
+$bawaan = static function (string $kunci, string $nilai) use ($ambil): void {
+    if ($ambil($kunci) === null) {
+        putenv("{$kunci}={$nilai}");
+        $_ENV[$kunci] = $nilai;
+        $_SERVER[$kunci] = $nilai;
+    }
+};
+
+$tmp = rtrim(sys_get_temp_dir(), '/');
+$storage = $tmp.'/storage';
+
+foreach (['app/private', 'app/public', 'framework/cache/data', 'framework/sessions', 'framework/views', 'logs'] as $folder) {
+    $jalur = "{$storage}/{$folder}";
+
+    if (! is_dir($jalur) && ! mkdir($jalur, 0775, true) && ! is_dir($jalur)) {
+        throw new RuntimeException("Tidak dapat membuat folder {$jalur}");
+    }
+}
+
+$bawaan('VERCEL', '1');
+$bawaan('APP_NAME', 'Arsip Berkas KP dan TA');
+$bawaan('APP_ENV', 'production');
+$bawaan('APP_DEBUG', 'false');
+$bawaan('LOG_CHANNEL', 'stderr');
+$bawaan('SESSION_SECURE_COOKIE', 'true');
+$bawaan('VIEW_COMPILED_PATH', "{$storage}/framework/views");
+$bawaan('APP_PACKAGES_CACHE', "{$tmp}/packages.php");
+$bawaan('APP_SERVICES_CACHE', "{$tmp}/services.php");
+
+if (($ambil('DB_CONNECTION') ?? 'sqlite') === 'sqlite') {
+    $bawaan('SESSION_DRIVER', 'cookie');
+    $bawaan('CACHE_STORE', 'file');
+    $bawaan('QUEUE_CONNECTION', 'sync');
+
+    if ($ambil('DB_DATABASE') === null) {
+        $sumber = __DIR__.'/../database/database.sqlite';
+        $tujuan = "{$tmp}/database.sqlite";
+
+        // Kunci supaya request bersamaan pada saat instance baru menyala tidak saling menimpa salinan.
+        $kunci = fopen("{$tujuan}.lock", 'c');
+        flock($kunci, LOCK_EX);
+
+        if (! is_file($tujuan) && ! copy($sumber, $tujuan)) {
+            flock($kunci, LOCK_UN);
+            throw new RuntimeException('Tidak dapat menyalin database.sqlite ke '.$tujuan);
+        }
+
+        flock($kunci, LOCK_UN);
+        fclose($kunci);
+
+        $bawaan('DB_DATABASE', $tujuan);
+    }
+}
+
+require __DIR__.'/../vendor/autoload.php';
+
+/** @var \Illuminate\Foundation\Application $app */
+$app = require_once __DIR__.'/../bootstrap/app.php';
+
+$app->useStoragePath($storage);
+
+$app->handleRequest(Request::capture());
