+-- ============================================================================
+-- Sistem Pengumpulan dan Arsip Digital Berkas KP dan TA (Fasilkom Unsri)
+-- Database MySQL: arsip_kp_ta
+--
+-- Isi file: struktur seluruh tabel + data awal (program studi, persyaratan, akun contoh).
+-- Struktur dibuat dari file di database/migrations (pernyataan SQL yang sama dengan yang
+-- dijalankan "php artisan migrate"), data awal dari database/seeders.
+-- Tabel "migrations" ikut diisi, jadi "php artisan migrate" setelah impor akan melaporkan
+-- "Nothing to migrate" dan migrasi baru di kemudian hari tetap berjalan normal.
+--
+-- PERHATIAN: file ini menghapus (DROP) lalu membuat ulang semua tabel di atas. Data yang
+-- sudah ada di tabel-tabel itu akan hilang. Jangan diimpor ke database yang berisi data penting.
+-- Akun contoh (kata sandi: "password") hanya untuk pengembangan; ganti sebelum dipakai sungguhan.
+--
+-- Cara impor:  mysql -u root -p < database/sql/arsip_kp_ta.sql
+--   atau lewat phpMyAdmin: tab Import, pilih file ini.
+-- ============================================================================
+
+SET NAMES utf8mb4;
+SET FOREIGN_KEY_CHECKS = 0;
+
+CREATE DATABASE IF NOT EXISTS `arsip_kp_ta` DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
+USE `arsip_kp_ta`;
+
+-- ----------------------------------------------------------------------------
+-- Hapus tabel lama (urutan terbalik)
+-- ----------------------------------------------------------------------------
