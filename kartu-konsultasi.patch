@@ -0,0 +1,37 @@
+<?php
+
+namespace App\Http\Controllers\Mahasiswa;
+
+use App\Http\Controllers\Controller;
+use App\Models\Pengajuan;
+use App\Support\Pdf\KartuKonsultasi;
+use Illuminate\Http\Response;
+use Illuminate\Support\Str;
+use Symfony\Component\HttpFoundation\HeaderUtils;
+
+/**
+ * Kartu konsultasi bimbingan KP/TA dalam bentuk PDF, dibuat saat diminta (tidak disimpan di server)
+ * dari data pengajuan yang sama dengan yang dilihat dosen dan operator.
+ */
+class KartuKonsultasiController extends Controller
+{
+    public function unduh(Pengajuan $pengajuan): Response
+    {
+        // Hanya pemilik pengajuan, dan hanya setelah dosen pembimbing sah (lihat PengajuanPolicy).
+        $this->authorize('unduhKartuKonsultasi', $pengajuan);
+
+        $pengajuan->load(['mahasiswa.programStudi', 'pembimbing']);
+
+        $pdf = KartuKonsultasi::buat($pengajuan->dataKartuKonsultasi(), public_path('images/UnsriLogo.png'));
+
+        $nama = 'kartu-konsultasi-'.$pengajuan->jenis->value.'-'
+            .Str::slug($pengajuan->mahasiswa->nomor_induk ?: $pengajuan->mahasiswa->name).'.pdf';
+
+        return response($pdf, 200, [
+            'Content-Type' => 'application/pdf',
+            'Content-Disposition' => HeaderUtils::makeDisposition(HeaderUtils::DISPOSITION_ATTACHMENT, $nama),
+            'Cache-Control' => 'private, no-store',
+            'X-Content-Type-Options' => 'nosniff',
+        ]);
+    }
+}
diff --git a/app/Models/Pengajuan.php b/app/Models/Pengajuan.php
index c2c7f4a..a7bd7e8 100644
--- a/app/Models/Pengajuan.php
+++ b/app/Models/Pengajuan.php
@@ -321,4 +321,46 @@ public function keteranganPembimbing(): string
                 : 'Belum ditentukan.',
         };
     }
+
+    /**
+     * Alasan kartu konsultasi belum bisa diunduh, atau null bila boleh.
+     * Kartu memuat dosen pembimbing, jadi baru tersedia setelah pembimbing sah (diterima atau ditetapkan).
+     * Satu-satunya tempat aturan ini; policy dan tampilan memakainya.
+     */
+    public function hambatanKartuKonsultasi(): ?string
+    {
+        if ($this->pembimbing_id !== null && $this->status_pembimbing->aktif()) {
+            return null;
+        }
+
+        return match ($this->status_pembimbing) {
+            StatusPembimbing::Menunggu => 'Kartu konsultasi tersedia setelah dosen pembimbing menerima permintaan Anda.',
+            StatusPembimbing::Ditolak => 'Kartu konsultasi tersedia setelah operator akademik menetapkan dosen pembimbing pengganti.',
+            default => 'Kartu konsultasi tersedia setelah dosen pembimbing ditetapkan.',
+        };
+    }
+
+    /**
+     * Isi kartu konsultasi (lihat App\Support\Pdf\KartuKonsultasi).
+     * Relasi mahasiswa.programStudi dan pembimbing harus sudah dimuat.
+     *
+     * @return array{jenis: string, nama: string, nim: ?string, prodi: ?string, judul: string, instansi: ?string, pembimbing: ?string, pembimbing_nomor: ?string, dicetak: string}
+     */
+    public function dataKartuKonsultasi(): array
+    {
+        $mahasiswa = $this->mahasiswa;
+        $prodi = $mahasiswa->programStudi?->namaLengkap();
+
+        return [
+            'jenis' => $this->jenis->label(),
+            'nama' => $mahasiswa->name,
+            'nim' => $mahasiswa->nomor_induk,
+            'prodi' => $prodi !== null && $mahasiswa->angkatan ? "{$prodi}, angkatan {$mahasiswa->angkatan}" : $prodi,
+            'judul' => $this->judul,
+            'instansi' => $this->instansi,
+            'pembimbing' => $this->pembimbing?->name,
+            'pembimbing_nomor' => $this->pembimbing?->nomor_induk,
+            'dicetak' => now()->translatedFormat('d F Y'),
+        ];
+    }
 }
diff --git a/app/Policies/PengajuanPolicy.php b/app/Policies/PengajuanPolicy.php
index e680153..600647f 100644
--- a/app/Policies/PengajuanPolicy.php
+++ b/app/Policies/PengajuanPolicy.php
@@ -70,6 +70,17 @@ public function konfirmasiPembimbing(User $user, Pengajuan $pengajuan): bool
             && $pengajuan->status !== StatusPengajuan::Draft;
     }
 
+    /**
+     * Mahasiswa pemilik mengunduh kartu konsultasi (PDF) setelah dosen pembimbingnya sah.
+     * Aturan kesiapan ada di Pengajuan::hambatanKartuKonsultasi().
+     */
+    public function unduhKartuKonsultasi(User $user, Pengajuan $pengajuan): bool
+    {
+        return $user->role === Role::Mahasiswa
+            && (int) $pengajuan->mahasiswa_id === (int) $user->id
+            && $pengajuan->hambatanKartuKonsultasi() === null;
+    }
+
     /** Operator menetapkan atau mengganti dosen pembimbing selama belum diarsipkan. */
     public function kelola(User $user, Pengajuan $pengajuan): bool
     {
diff --git a/app/Support/Pdf/Dokumen.php b/app/Support/Pdf/Dokumen.php
new file mode 100644
index 0000000..f5e4a5a
--- /dev/null
+++ b/app/Support/Pdf/Dokumen.php
@@ -0,0 +1,362 @@
+<?php
+
+namespace App\Support\Pdf;
+
+use InvalidArgumentException;
+
+/**
+ * Penulis PDF sederhana tanpa dependensi: halaman A4, teks (Helvetica), garis, kotak, dan gambar JPEG.
+ *
+ * Cukup untuk dokumen berbentuk formulir seperti kartu konsultasi. Untuk dokumen panjang atau
+ * tata letak yang kompleks, pakai pustaka PDF penuh.
+ *
+ * Koordinat dalam satuan poin (1 pt = 1/72 inci) dengan titik asal di KIRI ATAS halaman dan
+ * sumbu y mengarah ke bawah. Untuk teks, y adalah garis dasar (baseline).
+ * Teks diterima sebagai UTF-8 dan dicetak dalam Windows-1252 (huruf Latin lengkap dengan aksen);
+ * karakter di luar itu diganti "?".
+ */
+final class Dokumen
+{
+    /** A4: 210 x 297 mm. */
+    public const LEBAR = 595.28;
+
+    public const TINGGI = 841.89;
+
+    /** Lebar glyph Helvetica (satuan 1/1000 em) untuk kode 32..255 (WinAnsi). */
+    private const LEBAR_HELVETICA = [
+        278, 278, 355, 556, 556, 889, 667, 191, 333, 333, 389, 584, 278, 333, 278, 278,
+        556, 556, 556, 556, 556, 556, 556, 556, 556, 556, 278, 278, 584, 584, 584, 556,
+        1015, 667, 667, 722, 722, 667, 611, 778, 722, 278, 500, 667, 556, 833, 722, 778,
+        667, 778, 722, 667, 611, 722, 667, 944, 667, 667, 611, 278, 278, 278, 469, 556,
+        333, 556, 556, 500, 556, 556, 278, 556, 556, 222, 222, 500, 222, 833, 556, 556,
+        556, 556, 333, 500, 278, 556, 500, 722, 500, 500, 500, 334, 260, 334, 584, 761,
+        556, 556, 222, 556, 333, 1000, 556, 556, 333, 1000, 667, 333, 1000, 556, 611, 556,
+        556, 222, 222, 333, 333, 350, 556, 1000, 333, 1000, 500, 333, 944, 556, 500, 667,
+        278, 333, 556, 556, 556, 556, 260, 556, 333, 737, 370, 556, 584, 333, 737, 333,
+        400, 584, 333, 333, 333, 556, 537, 278, 333, 333, 365, 556, 834, 834, 834, 611,
+        667, 667, 667, 667, 667, 667, 1000, 722, 667, 667, 667, 667, 278, 278, 278, 278,
+        722, 722, 778, 778, 778, 778, 778, 584, 778, 722, 722, 722, 722, 667, 667, 611,
+        556, 556, 556, 556, 556, 556, 889, 500, 556, 556, 556, 556, 278, 278, 278, 278,
+        556, 556, 556, 556, 556, 556, 556, 584, 611, 556, 556, 556, 556, 500, 556, 500,
+    ];
+
+    /** Lebar glyph Helvetica-Bold (satuan 1/1000 em) untuk kode 32..255 (WinAnsi). */
+    private const LEBAR_HELVETICA_BOLD = [
+        278, 333, 474, 556, 556, 889, 722, 238, 333, 333, 389, 584, 278, 333, 278, 278,
+        556, 556, 556, 556, 556, 556, 556, 556, 556, 556, 333, 333, 584, 584, 584, 611,
+        975, 722, 722, 722, 722, 667, 611, 778, 722, 278, 556, 722, 611, 833, 722, 778,
+        667, 778, 722, 667, 611, 722, 667, 944, 667, 667, 611, 333, 278, 333, 584, 556,
+        333, 556, 611, 556, 611, 556, 333, 611, 611, 278, 278, 556, 278, 889, 611, 611,
+        611, 611, 389, 556, 333, 611, 556, 778, 556, 556, 500, 389, 280, 389, 584, 761,
+        556, 556, 278, 556, 500, 1000, 556, 556, 333, 1000, 667, 333, 1000, 556, 611, 556,
+        556, 278, 278, 500, 500, 350, 556, 1000, 333, 1000, 556, 333, 944, 556, 500, 667,
+        278, 333, 556, 556, 556, 556, 280, 556, 333, 737, 370, 556, 584, 333, 737, 333,
+        400, 584, 333, 333, 333, 611, 556, 278, 333, 333, 365, 556, 834, 834, 834, 611,
+        722, 722, 722, 722, 722, 722, 1000, 722, 667, 667, 667, 667, 278, 278, 278, 278,
+        722, 722, 778, 778, 778, 778, 778, 584, 778, 722, 722, 722, 722, 667, 667, 611,
+        556, 556, 556, 556, 556, 556, 889, 556, 556, 556, 556, 556, 278, 278, 278, 278,
+        611, 611, 611, 611, 611, 611, 611, 584, 611, 611, 611, 611, 611, 556, 611, 556,
+    ];
+
+    /** @var list<string> isi (content stream) halaman yang sudah selesai */
+    private array $halamanSelesai = [];
+
+    /** Isi halaman yang sedang digarap. */
+    private string $isi = '';
+
+    /** @var list<array{data: string, lebar: int, tinggi: int, kanal: int}> */
+    private array $gambar = [];
+
+    public function __construct(private string $judul = '') {}
+
+    /** Menutup halaman saat ini dan memulai halaman kosong berikutnya. */
+    public function halamanBaru(): void
+    {
+        $this->halamanSelesai[] = $this->isi;
+        $this->isi = '';
+    }
+
+    /**
+     * Menulis satu baris teks.
+     *
+     * @param  float  $x  tepi kiri; bila $rata bukan "kiri", tepi kiri kotak selebar $lebar
+     * @param  float  $y  garis dasar teks, diukur dari atas halaman
+     * @param  array{0: int, 1: int, 2: int}  $warna  RGB 0..255
+     * @param  'kiri'|'tengah'|'kanan'  $rata
+     */
+    public function teks(
+        float $x,
+        float $y,
+        string $teks,
+        float $ukuran = 10,
+        bool $tebal = false,
+        array $warna = [0, 0, 0],
+        string $rata = 'kiri',
+        ?float $lebar = null,
+    ): void {
+        if ($teks === '') {
+            return;
+        }
+
+        if ($rata !== 'kiri' && $lebar !== null) {
+            $sisa = $lebar - $this->lebarTeks($teks, $ukuran, $tebal);
+            $x += $rata === 'tengah' ? $sisa / 2 : $sisa;
+        }
+
+        $this->isi .= sprintf(
+            "BT %s /%s %s Tf %s %s Td (%s) Tj ET\n",
+            $this->warnaIsi($warna),
+            $tebal ? 'F2' : 'F1',
+            $this->angka($ukuran),
+            $this->angka($x),
+            $this->angka(self::TINGGI - $y),
+            $this->escape($this->enkode($teks)),
+        );
+    }
+
+    /** Lebar teks dalam poin pada ukuran huruf tertentu. */
+    public function lebarTeks(string $teks, float $ukuran = 10, bool $tebal = false): float
+    {
+        $tabel = $tebal ? self::LEBAR_HELVETICA_BOLD : self::LEBAR_HELVETICA;
+        $total = 0;
+
+        foreach (str_split($this->enkode($teks)) as $karakter) {
+            $kode = ord($karakter);
+            $total += $kode >= 32 ? $tabel[$kode - 32] : 0;
+        }
+
+        return $total * $ukuran / 1000;
+    }
+
+    /**
+     * Memecah teks menjadi baris-baris yang masing-masing muat dalam $lebarMaks.
+     * Kata yang lebih panjang dari satu baris dipotong per karakter.
+     *
+     * @return list<string>
+     */
+    public function bungkus(string $teks, float $lebarMaks, float $ukuran = 10, bool $tebal = false): array
+    {
+        $teks = trim((string) preg_replace('/\s+/u', ' ', mb_scrub($teks)));
+        if ($teks === '') {
+            return [];
+        }
+
+        $baris = [];
+        $saatIni = '';
+
+        foreach (explode(' ', $teks) as $kata) {
+            $calon = $saatIni === '' ? $kata : $saatIni.' '.$kata;
+
+            if ($this->lebarTeks($calon, $ukuran, $tebal) <= $lebarMaks) {
+                $saatIni = $calon;
+
+                continue;
+            }
+
+            if ($saatIni !== '') {
+                $baris[] = $saatIni;
+                $saatIni = '';
+            }
+
+            // Kata panjang: potong per karakter sampai muat.
+            $potongan = '';
+            foreach (mb_str_split($kata) as $huruf) {
+                if ($potongan !== '' && $this->lebarTeks($potongan.$huruf, $ukuran, $tebal) > $lebarMaks) {
+                    $baris[] = $potongan;
+                    $potongan = '';
+                }
+                $potongan .= $huruf;
+            }
+            $saatIni = $potongan;
+        }
+
+        if ($saatIni !== '') {
+            $baris[] = $saatIni;
+        }
+
+        return $baris;
+    }
+
+    /**
+     * @param  array{0: int, 1: int, 2: int}  $warna
+     * @param  list<float>|null  $putus  pola garis putus-putus, mis. [3, 2]
+     */
+    public function garis(float $x1, float $y1, float $x2, float $y2, float $tebal = 0.5, array $warna = [0, 0, 0], ?array $putus = null): void
+    {
+        $pola = $putus === null ? '' : '['.implode(' ', array_map($this->angka(...), $putus)).'] 0 d ';
+
+        $this->isi .= sprintf(
+            "q %s %s w %s%s %s m %s %s l S Q\n",
+            $this->warnaGaris($warna),
+            $this->angka($tebal),
+            $pola,
+            $this->angka($x1), $this->angka(self::TINGGI - $y1),
+            $this->angka($x2), $this->angka(self::TINGGI - $y2),
+        );
+    }
+
+    /**
+     * Kotak dengan sudut kiri atas di ($x, $y).
+     *
+     * @param  array{0: int, 1: int, 2: int}|null  $isi  warna isi, null = tanpa isi
+     * @param  array{0: int, 1: int, 2: int}|null  $garis  warna garis tepi, null = tanpa garis tepi
+     */
+    public function kotak(float $x, float $y, float $lebar, float $tinggi, ?array $isi = null, ?array $garis = [0, 0, 0], float $tebal = 0.5): void
+    {
+        if ($isi === null && $garis === null) {
+            return;
+        }
+
+        $operator = match (true) {
+            $isi !== null && $garis !== null => 'B',
+            $isi !== null => 'f',
+            default => 'S',
+        };
+
+        $this->isi .= sprintf(
+            "q %s %s %s w %s %s %s %s re %s Q\n",
+            $isi !== null ? $this->warnaIsi($isi) : '',
+            $garis !== null ? $this->warnaGaris($garis) : '',
+            $this->angka($tebal),
+            $this->angka($x), $this->angka(self::TINGGI - $y - $tinggi),
+            $this->angka($lebar), $this->angka($tinggi),
+            $operator,
+        );
+    }
+
+    /**
+     * Menempatkan gambar JPEG (RGB atau grayscale) pada kotak ($x, $y, $lebar, $tinggi).
+     * Data yang sama dipakai ulang, tidak disimpan dua kali di dalam berkas.
+     */
+    public function gambarJpeg(string $dataJpeg, float $x, float $y, float $lebar, float $tinggi): void
+    {
+        $info = @getimagesizefromstring($dataJpeg);
+        $kanal = $info['channels'] ?? 3;
+
+        if ($info === false || $info[2] !== IMAGETYPE_JPEG || ! in_array($kanal, [1, 3], true)) {
+            throw new InvalidArgumentException('Gambar harus berupa JPEG RGB atau grayscale yang valid.');
+        }
+
+        $indeks = array_search($dataJpeg, array_column($this->gambar, 'data'), true);
+        if ($indeks === false) {
+            $this->gambar[] = ['data' => $dataJpeg, 'lebar' => $info[0], 'tinggi' => $info[1], 'kanal' => $kanal];
+            $indeks = array_key_last($this->gambar);
+        }
+
+        $this->isi .= sprintf(
+            "q %s 0 0 %s %s %s cm /Im%d Do Q\n",
+            $this->angka($lebar), $this->angka($tinggi),
+            $this->angka($x), $this->angka(self::TINGGI - $y - $tinggi),
+            $indeks + 1,
+        );
+    }
+
+    /** Menyusun seluruh berkas PDF dan mengembalikannya sebagai string biner. */
+    public function hasil(): string
+    {
+        $halaman = [...$this->halamanSelesai, $this->isi];
+
+        // Nomor objek: 1 katalog, 2 daftar halaman, 3-4 font, 5 info, lalu gambar, lalu pasangan (isi, halaman).
+        $idGambar = [];
+        $berikut = 6;
+        foreach (array_keys($this->gambar) as $i) {
+            $idGambar[$i] = $berikut++;
+        }
+
+        $sumber = '/Font << /F1 3 0 R /F2 4 0 R >>';
+        if ($idGambar !== []) {
+            $sumber .= ' /XObject << '.implode(' ', array_map(
+                fn (int $i, int $id) => '/Im'.($i + 1).' '.$id.' 0 R',
+                array_keys($idGambar),
+                $idGambar,
+            )).' >>';
+        }
+
+        $objek = [
+            1 => '<< /Type /Catalog /Pages 2 0 R >>',
+            3 => '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>',
+            4 => '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>',
+            5 => '<< /Title <'.$this->hexUtf16($this->judul).'> /Producer (Arsip Berkas KP dan TA) >>',
+        ];
+
+        foreach ($this->gambar as $i => $g) {
+            $objek[$idGambar[$i]] = sprintf(
+                "<< /Type /XObject /Subtype /Image /Width %d /Height %d /ColorSpace %s /BitsPerComponent 8 /Filter /DCTDecode /Length %d >>\nstream\n%s\nendstream",
+                $g['lebar'], $g['tinggi'], $g['kanal'] === 1 ? '/DeviceGray' : '/DeviceRGB', strlen($g['data']), $g['data'],
+            );
+        }
+
+        $idHalaman = [];
+        foreach ($halaman as $isi) {
+            $idIsi = $berikut++;
+            $idHalaman[] = $idPage = $berikut++;
+
+            $objek[$idIsi] = sprintf("<< /Length %d >>\nstream\n%s\nendstream", strlen($isi), $isi);
+            $objek[$idPage] = sprintf(
+                '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 %s %s] /Resources << %s >> /Contents %d 0 R >>',
+                $this->angka(self::LEBAR), $this->angka(self::TINGGI), $sumber, $idIsi,
+            );
+        }
+
+        $objek[2] = sprintf(
+            '<< /Type /Pages /Kids [%s] /Count %d >>',
+            implode(' ', array_map(fn (int $id) => $id.' 0 R', $idHalaman)),
+            count($idHalaman),
+        );
+
+        ksort($objek);
+
+        $pdf = "%PDF-1.4\n%\xE2\xE3\xCF\xD3\n";
+        $posisi = [];
+        foreach ($objek as $id => $badan) {
+            $posisi[$id] = strlen($pdf);
+            $pdf .= "{$id} 0 obj\n{$badan}\nendobj\n";
+        }
+
+        $jumlah = max(array_keys($objek)) + 1;
+        $mulaiXref = strlen($pdf);
+        $pdf .= "xref\n0 {$jumlah}\n0000000000 65535 f \n";
+        for ($id = 1; $id < $jumlah; $id++) {
+            $pdf .= sprintf("%010d 00000 n \n", $posisi[$id]);
+        }
+
+        return $pdf."trailer\n<< /Size {$jumlah} /Root 1 0 R /Info 5 0 R >>\nstartxref\n{$mulaiXref}\n%%EOF\n";
+    }
+
+    /** UTF-8 ke Windows-1252; aman terhadap UTF-8 rusak dan karakter kontrol. */
+    private function enkode(string $teks): string
+    {
+        $teks = (string) preg_replace('/[\x00-\x1F\x7F]+/u', ' ', mb_scrub($teks));
+
+        return mb_convert_encoding($teks, 'Windows-1252', 'UTF-8');
+    }
+
+    private function escape(string $teks): string
+    {
+        return strtr($teks, ['\\' => '\\\\', '(' => '\\(', ')' => '\\)']);
+    }
+
+    /** String Unicode PDF (UTF-16BE dengan BOM) dalam heksadesimal, untuk judul dokumen. */
+    private function hexUtf16(string $teks): string
+    {
+        return 'FEFF'.strtoupper(bin2hex(mb_convert_encoding(mb_scrub($teks), 'UTF-16BE', 'UTF-8')));
+    }
+
+    /** Bilangan desimal dengan titik, tidak terpengaruh locale. */
+    private function angka(float $nilai): string
+    {
+        return rtrim(rtrim(sprintf('%.2F', $nilai), '0'), '.') ?: '0';
+    }
+
+    /** @param  array{0: int, 1: int, 2: int}  $rgb */
+    private function warnaIsi(array $rgb): string
+    {
+        return implode(' ', array_map(fn (int $k) => $this->angka($k / 255), $rgb)).' rg';
+    }
+
+    /** @param  array{0: int, 1: int, 2: int}  $rgb */
+    private function warnaGaris(array $rgb): string
+    {
+        return implode(' ', array_map(fn (int $k) => $this->angka($k / 255), $rgb)).' RG';
+    }
+}
diff --git a/app/Support/Pdf/KartuKonsultasi.php b/app/Support/Pdf/KartuKonsultasi.php
new file mode 100644
index 0000000..7cb825d
--- /dev/null
+++ b/app/Support/Pdf/KartuKonsultasi.php
@@ -0,0 +1,244 @@
+<?php
+
+namespace App\Support\Pdf;
+
+/**
+ * Tata letak PDF "Kartu Konsultasi" (Kerja Praktik dan Tugas Akhir) satu halaman A4.
+ *
+ * Kartu berisi identitas mahasiswa, judul, dan dosen pembimbing yang diisi dari sistem,
+ * serta tabel kosong untuk mencatat konsultasi dengan tulisan tangan yang diparaf pembimbing.
+ *
+ * Kelas ini hanya menyusun dokumen dari data biasa (array) sehingga bisa diuji tanpa Laravel.
+ * Data diambil dari Pengajuan::dataKartuKonsultasi().
+ */
+final class KartuKonsultasi
+{
+    private const UNIVERSITAS = 'UNIVERSITAS SRIWIJAYA';
+
+    private const FAKULTAS = 'FAKULTAS ILMU KOMPUTER';
+
+    private const SISTEM = 'Sistem Pengumpulan dan Arsip Digital Berkas KP dan TA';
+
+    private const NAVY = [27, 49, 96];
+
+    private const ABU = [100, 116, 139];
+
+    private const GARIS = [148, 163, 184];
+
+    private const MARGIN = 50;
+
+    /** Tinggi satu baris tabel konsultasi, cukup untuk tulisan tangan. */
+    private const TINGGI_BARIS = 32;
+
+    private const TINGGI_HEADER = 26;
+
+    /** Jarak garis dasar label tanda tangan dari tepi bawah halaman; blok ini tetap, tabel yang menyesuaikan. */
+    private const TTD_DARI_BAWAH = 150;
+
+    /** Jarak kosong antara dasar tabel dan label tanda tangan. */
+    private const JEDA_TTD = 22;
+
+    private const BARIS_MIN = 5;
+
+    private const BARIS_MAKS = 14;
+
+    /**
+     * @param  array{jenis: string, nama: string, nim: ?string, prodi: ?string, judul: string, instansi: ?string, pembimbing: ?string, pembimbing_nomor: ?string, dicetak: string}  $data
+     * @param  string|null  $logoPng  path berkas PNG logo; kop dicetak tanpa logo bila null, tidak ditemukan, atau ekstensi GD tidak aktif
+     * @return string isi berkas PDF
+     */
+    public static function buat(array $data, ?string $logoPng = null): string
+    {
+        $d = new Dokumen('Kartu Konsultasi '.$data['jenis'].' - '.$data['nama']);
+
+        $kiri = self::MARGIN;
+        $kanan = Dokumen::LEBAR - self::MARGIN;
+        $lebar = $kanan - $kiri;
+
+        self::kop($d, $kiri, $lebar, $logoPng);
+
+        // Judul dokumen
+        $d->teks($kiri, 136, 'KARTU KONSULTASI '.mb_strtoupper($data['jenis']), 14, true, self::NAVY, 'tengah', $lebar);
+        $d->teks($kiri, 151, 'Dibawa pada setiap konsultasi dan diparaf oleh dosen pembimbing.', 8.5, false, self::ABU, 'tengah', $lebar);
+
+        $yTtd = Dokumen::TINGGI - self::TTD_DARI_BAWAH;
+
+        $y = self::identitas($d, $data, $kiri, $kanan, 182);
+        self::tabel($d, $kiri, $lebar, $y + 12, $yTtd - self::JEDA_TTD);
+        self::tandaTangan($d, $data, $kiri, $kanan, $yTtd);
+
+        $d->teks($kiri, Dokumen::TINGGI - 38, 'Dicetak dari '.self::SISTEM.' pada '.$data['dicetak'].'.', 8, false, self::ABU, 'tengah', $lebar);
+
+        return $d->hasil();
+    }
+
+    private static function kop(Dokumen $d, float $kiri, float $lebar, ?string $logoPng): void
+    {
+        $jpeg = self::logoJpeg($logoPng);
+        if ($jpeg !== null) {
+            [$w, $h] = getimagesizefromstring($jpeg);
+            $tinggi = 58;
+            $d->gambarJpeg($jpeg, $kiri, 34, $tinggi * $w / $h, $tinggi);
+        }
+
+        $d->teks($kiri, 58, self::UNIVERSITAS, 15, true, self::NAVY, 'tengah', $lebar);
+        $d->teks($kiri, 75, self::FAKULTAS, 12.5, true, self::NAVY, 'tengah', $lebar);
+        $d->teks($kiri, 90, self::SISTEM, 8.5, false, self::ABU, 'tengah', $lebar);
+
+        // Garis ganda penutup kop surat.
+        $d->garis($kiri, 100, $kiri + $lebar, 100, 1.8, self::NAVY);
+        $d->garis($kiri, 104, $kiri + $lebar, 104, 0.5, self::NAVY);
+    }
+
+    /**
+     * Blok identitas (label, titik dua, nilai).
+     *
+     * @param  array<string, mixed>  $data
+     * @return float posisi y tepat di bawah blok
+     */
+    private static function identitas(Dokumen $d, array $data, float $kiri, float $kanan, float $y): float
+    {
+        $kolomTitikDua = $kiri + 118;
+        $kolomNilai = $kolomTitikDua + 10;
+        $lebarNilai = $kanan - $kolomNilai;
+
+        $baris = [
+            ['Nama Mahasiswa', $data['nama'], true],
+            ['NIM', $data['nim'] ?: '-', false],
+            ['Program Studi', $data['prodi'] ?: '-', false],
+            ['Judul '.$data['jenis'], $data['judul'], false],
+        ];
+        if (! empty($data['instansi'])) {
+            $baris[] = ['Instansi', $data['instansi'], false];
+        }
+        $baris[] = ['Dosen Pembimbing', $data['pembimbing'] ?: '-', true];
+        if (! empty($data['pembimbing_nomor'])) {
+            $baris[] = ['NIP/NIDN Pembimbing', $data['pembimbing_nomor'], false];
+        }
+
+        foreach ($baris as [$label, $nilai, $tebal]) {
+            $teks = $d->bungkus((string) $nilai, $lebarNilai, 10.5, $tebal);
+            $teks = $teks === [] ? ['-'] : $teks;
+
+            $d->teks($kiri, $y, $label, 10.5);
+            $d->teks($kolomTitikDua, $y, ':', 10.5);
+            foreach ($teks as $i => $potongan) {
+                $d->teks($kolomNilai, $y + $i * 14, $potongan, 10.5, $tebal);
+            }
+
+            $y += count($teks) * 14 + 5;
+        }
+
+        return $y;
+    }
+
+    /**
+     * Tabel konsultasi kosong. Jumlah baris menyesuaikan sisa ruang antara $atas dan $batasBawah.
+     */
+    private static function tabel(Dokumen $d, float $kiri, float $lebar, float $atas, float $batasBawah): void
+    {
+        $sisa = $batasBawah - $atas - self::TINGGI_HEADER;
+        $jumlah = max(self::BARIS_MIN, min(self::BARIS_MAKS, (int) floor($sisa / self::TINGGI_BARIS)));
+
+        $kolom = ['No' => 30, 'Hari / Tanggal' => 95, 'Materi / Pokok Bahasan Konsultasi' => 270];
+        $kolom['Paraf Pembimbing'] = $lebar - array_sum($kolom);
+
+        $tinggiTotal = self::TINGGI_HEADER + $jumlah * self::TINGGI_BARIS;
+
+        // Kepala tabel
+        $d->kotak($kiri, $atas, $lebar, self::TINGGI_HEADER, self::NAVY, self::NAVY);
+        $x = $kiri;
+        foreach ($kolom as $judul => $lebarKolom) {
+            $d->teks($x, $atas + 17, $judul, 9.5, true, [255, 255, 255], 'tengah', $lebarKolom);
+            $x += $lebarKolom;
+        }
+
+        // Garis dalam: horizontal per baris, vertikal per kolom.
+        for ($i = 1; $i < $jumlah; $i++) {
+            $yGaris = $atas + self::TINGGI_HEADER + $i * self::TINGGI_BARIS;
+            $d->garis($kiri, $yGaris, $kiri + $lebar, $yGaris, 0.5, self::GARIS);
+        }
+        $x = $kiri;
+        foreach (array_slice($kolom, 0, -1, true) as $lebarKolom) {
+            $x += $lebarKolom;
+            $d->garis($x, $atas + self::TINGGI_HEADER, $x, $atas + $tinggiTotal, 0.5, self::GARIS);
+        }
+
+        // Nomor urut dicetak agar pembimbing dapat menghitung pertemuan; kolom lain dikosongkan.
+        for ($i = 0; $i < $jumlah; $i++) {
+            $d->teks(
+                $kiri,
+                $atas + self::TINGGI_HEADER + $i * self::TINGGI_BARIS + 20,
+                (string) ($i + 1),
+                9.5,
+                false,
+                self::ABU,
+                'tengah',
+                $kolom['No'],
+            );
+        }
+
+        // Bingkai luar paling akhir agar tidak tertimpa garis dalam.
+        $d->kotak($kiri, $atas, $lebar, $tinggiTotal, null, self::NAVY, 0.8);
+    }
+
+    /**
+     * Blok tanda tangan mahasiswa (kiri) dan dosen pembimbing (kanan).
+     *
+     * @param  array<string, mixed>  $data
+     */
+    private static function tandaTangan(Dokumen $d, array $data, float $kiri, float $kanan, float $y): void
+    {
+        $lebarBlok = 190;
+        $kolom = [
+            [$kiri, 'Mahasiswa,', $data['nama'], $data['nim'] ? 'NIM. '.$data['nim'] : null],
+            [$kanan - $lebarBlok, 'Dosen Pembimbing,', $data['pembimbing'] ?: '', ! empty($data['pembimbing_nomor']) ? 'NIP/NIDN. '.$data['pembimbing_nomor'] : null],
+        ];
+
+        foreach ($kolom as [$x, $peran, $nama, $nomor]) {
+            $d->teks($x, $y, $peran, 10, false, [0, 0, 0], 'tengah', $lebarBlok);
+
+            // Ruang tanda tangan 54 pt, lalu nama bergaris bawah dan nomor induk.
+            $yNama = $y + 66;
+            foreach ($d->bungkus((string) $nama, $lebarBlok, 10, true) as $i => $potongan) {
+                $d->teks($x, $yNama + $i * 12, $potongan, 10, true, [0, 0, 0], 'tengah', $lebarBlok);
+                $garisBawah = $d->lebarTeks($potongan, 10, true);
+                $mulai = $x + ($lebarBlok - $garisBawah) / 2;
+                $d->garis($mulai, $yNama + $i * 12 + 1.5, $mulai + $garisBawah, $yNama + $i * 12 + 1.5, 0.5);
+            }
+
+            if ($nomor !== null) {
+                $d->teks($x, $yNama + 14 + max(0, count($d->bungkus((string) $nama, $lebarBlok, 10, true)) - 1) * 12, $nomor, 9.5, false, [0, 0, 0], 'tengah', $lebarBlok);
+            }
+        }
+    }
+
+    /**
+     * Logo PNG (umumnya bertransparansi) diratakan ke latar putih dan dijadikan JPEG agar bisa
+     * ditanam langsung ke PDF. Null bila logo tidak tersedia atau ekstensi GD tidak aktif.
+     */
+    private static function logoJpeg(?string $png): ?string
+    {
+        if ($png === null || ! is_file($png) || ! function_exists('imagecreatefrompng')) {
+            return null;
+        }
+
+        $sumber = @imagecreatefrompng($png);
+        if ($sumber === false) {
+            return null;
+        }
+
+        $lebar = imagesx($sumber);
+        $tinggi = imagesy($sumber);
+
+        $kanvas = imagecreatetruecolor($lebar, $tinggi);
+        imagefill($kanvas, 0, 0, (int) imagecolorallocate($kanvas, 255, 255, 255));
+        imagecopy($kanvas, $sumber, 0, 0, 0, 0, $lebar, $tinggi);
+
+        ob_start();
+        imagejpeg($kanvas, null, 90);
+        $jpeg = ob_get_clean();
+
+        return is_string($jpeg) && $jpeg !== '' ? $jpeg : null;
+    }
+}
