+        <tr><td class="k">Pembimbing 2</td><td class="t">:</td><td>{{ $pembimbing2?->nama ?? '-' }}</td></tr>
+        <tr><td class="k">Nomor SK</td><td class="t">:</td><td>{{ $sk?->nomor ?? '-' }}</td></tr>
+    </table>
+
+    <table class="log">
