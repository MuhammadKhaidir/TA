+/** Pekerjaan Admin di panel /admin: surat pengantar, pencatatan SK offline, dan penjadwalan sidang. */
+class PanelAdminRevisiTest extends TestCase
+{
+    use MenyiapkanData, RefreshDatabase;
+
+    private User $admin;
+
+    protected function setUp(): void
+    {
