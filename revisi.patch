+
+    public function test_penjadwalan_di_panel_menolak_pembimbing_sebagai_penguji(): void
+    {
+        Persyaratan::create(['jenis' => 'ta_sidang', 'nama' => 'Transkrip', 'wajib' => true, 'aktif' => true, 'urutan' => 1]);
